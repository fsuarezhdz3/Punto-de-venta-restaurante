{
  "name": "pos-frontend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "electron:dev": "electron electron-main.js",
    "electron:build": "npm run build:web && electron-builder --win --dir",
    "electron:installer": "npm run build:web && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.lacocina.pos",
    "productName": "POS La Cocina de mi Ama",
    "directories": {
      "output": "dist-electron"
    },
    "extraMetadata": {
      "main": "electron-main.js"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/iconoapp.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.1",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.19",
    "expo-av": "^16.0.8",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "private": true,
  "devDependencies": {
    "eas-cli": "^27.5.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
